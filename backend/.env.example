# Server Port
PORT=5000

# Telegram Bot Token (Get this from @BotFather on Telegram)
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=

# Telegram WebApp URL (When deploying, set to your frontend URL or ngrok/localtunnel URL)
# For local browser testing: http://localhost:5173
WEBAPP_URL=http://localhost:5173

# Channels configuration
OFFICIAL_CHANNEL=https://t.me/telegram
PROMOTER_CHANNEL=https://t.me/durov

